<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3FFF4">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Titre -->
        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bravo ! 🎉"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <!-- Carte score -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/txtScoreResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Votre score : 0 / 20"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/black"
                    android:paddingBottom="8dp" />

                <TextView
                    android:id="@+id/txtSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Très bien ! Continue comme ça 💪"
                    android:textSize="15sp"
                    android:textColor="@android:color/darker_gray" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Carte info -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Prochaine étape"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@android:color/black"
                    android:paddingBottom="6dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tu peux passer au quiz pour tester tes connaissances sur le tri."
                    android:textSize="14sp"
                    android:textColor="@android:color/darker_gray" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Bouton principal -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToQuiz"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Passer au quiz"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            app:cornerRadius="28dp"
            app:backgroundTint="@color/vert_principal"
            android:layout_marginBottom="12dp" />

        <!-- Bouton secondaire -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReplay"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Rejouer"
            android:textAllCaps="false"
            android:textColor="@android:color/black"
            app:cornerRadius="28dp"
            app:strokeWidth="2dp"
            app:strokeColor="@color/vert_principal"
            app:backgroundTint="@android:color/transparent" />

    </LinearLayout>
</ScrollView>
