<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <!-- AppBar + flèche retour -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/white"
            app:navigationIcon="@drawable/ic_arrow_back_24"
            app:title="Demander un bac"
            app:titleTextColor="@color/input_black" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Contenu principal -->
    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/appBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="24dp">

            <!-- Petite explication (sans id, ne casse rien) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Renseigne les informations ci-dessous pour envoyer ta demande."
                android:textSize="14sp"
                android:textColor="@color/hint_gray"
                android:layout_marginBottom="16dp" />

            <!-- Adresse (pré-remplie, pas modifiable) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/inputAdresse"
                style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.Dense"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Adresse"
                android:layout_marginBottom="14dp"
                app:boxBackgroundMode="filled"
                app:boxBackgroundColor="@color/vert_second"
                app:boxCornerRadiusTopStart="18dp"
                app:boxCornerRadiusTopEnd="18dp"
                app:boxCornerRadiusBottomStart="18dp"
                app:boxCornerRadiusBottomEnd="18dp"
                app:boxStrokeWidth="0dp"
                app:boxStrokeWidthFocused="0dp"
                app:boxStrokeColor="@android:color/transparent"
                app:hintTextColor="@color/hint_gray">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etAdresse"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:inputType="textPostalAddress"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:textColor="@color/input_black"
                    android:textColorHint="@color/hint_gray"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Type de bac (liste déroulante) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/inputTypeBac"
                style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.Dense.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Type de bac demandé"
                android:layout_marginBottom="14dp"
                app:boxBackgroundMode="filled"
                app:boxBackgroundColor="@color/vert_second"
                app:boxCornerRadiusTopStart="18dp"
                app:boxCornerRadiusTopEnd="18dp"
                app:boxCornerRadiusBottomStart="18dp"
                app:boxCornerRadiusBottomEnd="18dp"
                app:boxStrokeWidth="0dp"
                app:boxStrokeWidthFocused="0dp"
                app:boxStrokeColor="@android:color/transparent"
                app:hintTextColor="@color/hint_gray">

                <AutoCompleteTextView
                    android:id="@+id/autoTypeBac"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:textColor="@color/input_black"
                    android:textColorHint="@color/hint_gray"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Raison (liste déroulante) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/inputRaison"
                style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.Dense.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Raison de la demande"
                android:layout_marginBottom="18dp"
                app:boxBackgroundMode="filled"
                app:boxBackgroundColor="@color/vert_second"
                app:boxCornerRadiusTopStart="18dp"
                app:boxCornerRadiusTopEnd="18dp"
                app:boxCornerRadiusBottomStart="18dp"
                app:boxCornerRadiusBottomEnd="18dp"
                app:boxStrokeWidth="0dp"
                app:boxStrokeWidthFocused="0dp"
                app:boxStrokeColor="@android:color/transparent"
                app:hintTextColor="@color/hint_gray">

                <AutoCompleteTextView
                    android:id="@+id/autoRaison"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:textColor="@color/input_black"
                    android:textColorHint="@color/hint_gray"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Commentaire -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/inputCommentaire"
                style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.Dense"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Commentaire (optionnel)"
                android:layout_marginBottom="22dp"
                app:boxBackgroundMode="filled"
                app:boxBackgroundColor="@color/vert_second"
                app:boxCornerRadiusTopStart="18dp"
                app:boxCornerRadiusTopEnd="18dp"
                app:boxCornerRadiusBottomStart="18dp"
                app:boxCornerRadiusBottomEnd="18dp"
                app:boxStrokeWidth="0dp"
                app:boxStrokeWidthFocused="0dp"
                app:boxStrokeColor="@android:color/transparent"
                app:hintTextColor="@color/hint_gray">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCommentaire"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine"
                    android:minLines="3"
                    android:maxLines="5"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:textColor="@color/input_black"
                    android:textColorHint="@color/hint_gray"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Bouton Envoyer -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEnvoyerDemande"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Envoyer la demande"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                app:cornerRadius="18dp"
                app:backgroundTint="@color/vert_principal"
                android:elevation="6dp"/>
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
