<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvNom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nom déchèterie"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/input_black"/>

        <TextView
            android:id="@+id/tvAdresse"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Adresse"
            android:textSize="13sp"
            android:textColor="@color/hint_gray"
            android:layout_marginTop="6dp"/>

        <TextView
            android:id="@+id/tvHoraires"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Horaires"
            android:textSize="13sp"
            android:textColor="@color/hint_gray"
            android:layout_marginTop="4dp"/>

        <TextView
            android:id="@+id/tvAcces"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Accès : habitants + justificatif"
            android:textSize="12sp"
            android:textColor="@color/input_black"
            android:background="@color/vert_second"
            android:padding="12dp"
            android:layout_marginTop="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRdv"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="RDV"
                android:textAllCaps="false"
                app:cornerRadius="16dp"
                app:strokeColor="@color/vert_principal"
                app:strokeWidth="1.5dp"
                android:textColor="@color/vert_principal"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnItineraire"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Itinéraire"
                android:textAllCaps="false"
                android:layout_marginStart="8dp"
                app:cornerRadius="16dp"
                app:strokeColor="@color/vert_principal"
                app:strokeWidth="1.5dp"
                android:textColor="@color/vert_principal"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAvis"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Avis"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:layout_marginStart="8dp"
                app:cornerRadius="16dp"
                app:backgroundTint="@color/vert_principal"/>
        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
