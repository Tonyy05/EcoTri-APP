<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    tools:context=".MainActivity">

    <!-- Logo -->
    <ImageView
        android:id="@+id/logo"
        android:layout_width="104dp"
        android:layout_height="104dp"
        android:layout_marginTop="32dp"
        android:contentDescription="@string/app_name"
        android:src="@drawable/recyclage"
        app:tint="@color/black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Welcome -->
    <TextView
        android:id="@+id/tvWelcome"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:text="Bienvenue sur EcoTri"
        android:textColor="@android:color/black"
        android:textSize="30sp"
        android:textStyle="bold"
        android:gravity="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/logo" />

    <!-- Actions principales -->
    <androidx.gridlayout.widget.GridLayout
        android:id="@+id/gridMainActions"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        app:alignmentMode="alignMargins"
        app:columnCount="2"
        app:rowCount="2"
        app:rowOrderPreserved="false"
        app:useDefaultMargins="true"
        app:layout_constraintBottom_toTopOf="@id/navDivider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvWelcome">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnQuiz"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:text="Quiz recyclage"
            android:textAllCaps="false"
            android:textColor="#000000"
            app:backgroundTint="#A6F48D"
            app:cornerRadius="18dp"
            app:layout_columnWeight="1"
            app:layout_gravity="fill_horizontal" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPlayGame"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:text="Jeu de tri"
            android:textAllCaps="false"
            android:textColor="#000000"
            app:backgroundTint="#A6F48D"
            app:cornerRadius="18dp"
            app:layout_columnWeight="1"
            app:layout_gravity="fill_horizontal" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHistory"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:text="Historique scores"
            android:textAllCaps="false"
            android:textColor="#000000"
            app:backgroundTint="#A6F48D"
            app:cornerRadius="18dp"
            app:layout_columnWeight="1"
            app:layout_gravity="fill_horizontal" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLeaderboard"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:text="Classement"
            android:textAllCaps="false"
            android:textColor="#000000"
            app:backgroundTint="#A6F48D"
            app:cornerRadius="18dp"
            app:layout_columnWeight="1"
            app:layout_gravity="fill_horizontal" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAssistant"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:text="Assistant IA"
            android:textAllCaps="false"
            android:textColor="#000000"
            app:backgroundTint="#A6F48D"
            app:cornerRadius="18dp"
            app:layout_columnWeight="1"
            app:layout_gravity="fill_horizontal" />

    </androidx.gridlayout.widget.GridLayout>

    <!-- Trait séparateur -->
    <View
        android:id="@+id/navDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#1F000000"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Bottom nav -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="76dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageButton
            android:id="@+id/btnJeu"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:adjustViewBounds="true"
            android:background="@android:color/transparent"
            android:contentDescription="Jeu"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_nav_play" />

        <ImageButton
            android:id="@+id/btnCalendrier"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:adjustViewBounds="true"
            android:background="@android:color/transparent"
            android:contentDescription="Calendrier"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_nav_calendar" />

        <ImageButton
            android:id="@+id/btnDecheterie"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:adjustViewBounds="true"
            android:background="@android:color/transparent"
            android:contentDescription="Déchèteries"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_nav_decheterie" />

        <ImageButton
            android:id="@+id/btnProfil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:adjustViewBounds="true"
            android:background="@android:color/transparent"
            android:contentDescription="Profil"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_nav_profile" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
