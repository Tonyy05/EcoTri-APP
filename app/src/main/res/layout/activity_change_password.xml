<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <!-- AppBar + flèche retour -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="0dp"
        android:background="@android:color/white">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/white"
            app:navigationIcon="@drawable/ic_arrow_back_24"
            app:title=""
            app:titleTextColor="@color/input_black" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Contenu + barre de nav -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Contenu scrollable -->
        <ScrollView
            android:id="@+id/scrollContent"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:overScrollMode="never"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/navDivider"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="18dp"
                android:paddingBottom="24dp">

                <!-- Titre -->
                <TextView
                    android:id="@+id/tvTitleChangePwd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:text="Compte"
                    android:textStyle="bold"
                    android:textSize="32sp"
                    android:textColor="@color/input_black" />

                <TextView
                    android:id="@+id/tvSubtitleChangePwd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="6dp"
                    android:text="Modifie ton mot de passe en toute sécurité"
                    android:textSize="14sp"
                    android:textColor="@color/hint_gray" />

                <!-- Ancien mot de passe -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilOldPassword"
                    style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.Dense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    app:boxBackgroundMode="filled"
                    app:boxBackgroundColor="@color/vert_second"
                    app:boxStrokeColor="@android:color/transparent"
                    app:boxStrokeWidth="0dp"
                    app:boxStrokeWidthFocused="0dp"
                    app:boxCornerRadiusTopStart="18dp"
                    app:boxCornerRadiusTopEnd="18dp"
                    app:boxCornerRadiusBottomStart="18dp"
                    app:boxCornerRadiusBottomEnd="18dp"
                    app:endIconMode="password_toggle"
                    app:endIconTint="@color/input_black"
                    app:hintTextColor="@color/hint_gray">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etOldPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Ancien mot de passe"
                        android:inputType="textPassword"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp"
                        android:textColor="@color/input_black"
                        android:textColorHint="@color/hint_gray" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Nouveau mot de passe -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilNewPassword"
                    style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.Dense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:boxBackgroundMode="filled"
                    app:boxBackgroundColor="@color/vert_second"
                    app:boxStrokeColor="@android:color/transparent"
                    app:boxStrokeWidth="0dp"
                    app:boxStrokeWidthFocused="0dp"
                    app:boxCornerRadiusTopStart="18dp"
                    app:boxCornerRadiusTopEnd="18dp"
                    app:boxCornerRadiusBottomStart="18dp"
                    app:boxCornerRadiusBottomEnd="18dp"
                    app:endIconMode="password_toggle"
                    app:endIconTint="@color/input_black"
                    app:hintTextColor="@color/hint_gray">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etNewPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Nouveau mot de passe"
                        android:inputType="textPassword"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp"
                        android:textColor="@color/input_black"
                        android:textColorHint="@color/hint_gray" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Confirmation du nouveau mot de passe -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilConfirmPassword"
                    style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.Dense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:boxBackgroundMode="filled"
                    app:boxBackgroundColor="@color/vert_second"
                    app:boxStrokeColor="@android:color/transparent"
                    app:boxStrokeWidth="0dp"
                    app:boxStrokeWidthFocused="0dp"
                    app:boxCornerRadiusTopStart="18dp"
                    app:boxCornerRadiusTopEnd="18dp"
                    app:boxCornerRadiusBottomStart="18dp"
                    app:boxCornerRadiusBottomEnd="18dp"
                    app:endIconMode="password_toggle"
                    app:endIconTint="@color/input_black"
                    app:hintTextColor="@color/hint_gray">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etConfirmPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Confirmer le nouveau mot de passe"
                        android:inputType="textPassword"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp"
                        android:textColor="@color/input_black"
                        android:textColorHint="@color/hint_gray" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Bouton Changer le mot de passe -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnValidate"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="22dp"
                    android:text="Changer le mot de passe"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    app:cornerRadius="18dp"
                    app:backgroundTint="@color/vert_principal"
                    android:elevation="6dp" />

                <!-- Bouton Retour (outline plus pro) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBackChange"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="12dp"
                    android:text="Retour"
                    android:textAllCaps="false"
                    app:cornerRadius="18dp"
                    app:strokeColor="@color/vert_principal"
                    app:strokeWidth="1.5dp"
                    android:textColor="@color/vert_principal" />

            </LinearLayout>
        </ScrollView>

        <!-- Trait au-dessus de la nav bar -->
        <View
            android:id="@+id/navDivider"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="#1A000000"
            app:layout_constraintBottom_toTopOf="@id/bottomNav"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Barre de navigation du bas -->
        <LinearLayout
            android:id="@+id/bottomNav"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:background="@android:color/white"
            android:elevation="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Jeu -->
            <ImageButton
                android:id="@+id/navJeu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:src="@drawable/ic_nav_play"
                android:contentDescription="Jeu"
                android:background="@android:color/transparent"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:padding="10dp"
                app:tint="@color/black" />

            <!-- Calendrier -->
            <ImageButton
                android:id="@+id/navCalendrier"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:src="@drawable/ic_nav_calendar"
                android:contentDescription="Calendrier"
                android:background="@android:color/transparent"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:padding="10dp"
                app:tint="@color/black" />

            <!-- Déchèterie -->
            <ImageButton
                android:id="@+id/navDecheterie"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:src="@drawable/ic_nav_decheterie"
                android:contentDescription="Déchèterie"
                android:background="@android:color/transparent"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:padding="10dp"
                app:tint="@color/black" />

            <!-- Profil / Réglages actif -->
            <ImageButton
                android:id="@+id/navProfil"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:src="@drawable/ic_nav_profile"
                android:contentDescription="Compte"
                android:background="@android:color/transparent"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:padding="10dp"
                app:tint="@color/vert_principal" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
