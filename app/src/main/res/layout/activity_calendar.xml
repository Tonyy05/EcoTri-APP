<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <!-- Zone scrollable : titre + calendrier + légende + bouton -->
    <ScrollView
        android:id="@+id/scrollZone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/navDivider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="16dp">

            <!-- Titre -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Calendrier"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/input_black"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Collectes et informations"
                android:textSize="14sp"
                android:textColor="@color/hint_gray"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"/>

            <!-- Carte contenant le CalendarView -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCalendar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="6dp"
                app:cardUseCompatPadding="true"
                app:cardBackgroundColor="@color/vert_second">

                <CalendarView
                    android:id="@+id/calendarView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:firstDayOfWeek="2"
                    android:weekDayTextAppearance="@android:style/TextAppearance.Small"
                    android:dateTextAppearance="@android:style/TextAppearance.Medium"
                    android:padding="6dp"/>
            </com.google.android.material.card.MaterialCardView>

            <!-- Bloc "Légende" -->
            <TextView
                android:id="@+id/tvLegendTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Légende"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/input_black"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp"/>

            <!-- Légende : poubelle verte -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/legendBacVerte"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:visibility="gone"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/bac_verte">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="10dp"
                    android:paddingHorizontal="12dp"
                    android:text="Poubelle verte (ménagères)"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/black"
                    android:gravity="center"/>
            </com.google.android.material.card.MaterialCardView>

            <!-- Légende : poubelle jaune -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/legendBacJaune"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:visibility="gone"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/bac_jaune">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="10dp"
                    android:paddingHorizontal="12dp"
                    android:text="Poubelle jaune (recyclables)"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/black"
                    android:gravity="center"/>
            </com.google.android.material.card.MaterialCardView>

            <!-- Légende : poubelle verre -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/legendBacVerre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:visibility="gone"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/bac_verre">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="10dp"
                    android:paddingHorizontal="12dp"
                    android:text="Poubelle verre"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/black"
                    android:gravity="center"/>
            </com.google.android.material.card.MaterialCardView>

            <!-- Légende : végétaux -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/legendBacVegetaux"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:visibility="gone"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/bac_vegetaux">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="10dp"
                    android:paddingHorizontal="12dp"
                    android:text="Déchets verts"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/black"
                    android:gravity="center"/>
            </com.google.android.material.card.MaterialCardView>

            <!-- Légende : encombrants -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/legendEncombrants"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:visibility="gone"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/bac_encombrants">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="10dp"
                    android:paddingHorizontal="12dp"
                    android:text="Encombrants"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:gravity="center"/>
            </com.google.android.material.card.MaterialCardView>

            <!-- Bouton -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDemandeBac"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="18dp"
                android:text="Demander un bac"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                app:cornerRadius="18dp"
                app:backgroundTint="@color/vert_principal"
                android:elevation="6dp"/>

        </LinearLayout>
    </ScrollView>

    <!-- Trait séparateur au-dessus de la barre de navigation -->
    <View
        android:id="@+id/navDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#1A000000"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Barre de navigation identique à MainActivity -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:background="@android:color/white"
        android:elevation="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnJeu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/ic_nav_play"
            android:contentDescription="Jeu"
            android:background="@android:color/transparent"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:padding="10dp"
            app:tint="@color/black" />

        <ImageButton
            android:id="@+id/btnCalendrier"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/ic_nav_calendar"
            android:contentDescription="Calendrier"
            android:background="@android:color/transparent"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:padding="10dp"
            app:tint="@color/vert_principal"/>

        <ImageButton
            android:id="@+id/btnDecheterie"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/ic_nav_decheterie"
            android:contentDescription="Déchèteries"
            android:background="@android:color/transparent"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:padding="10dp"
            app:tint="@color/black" />

        <ImageButton
            android:id="@+id/btnProfil"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/ic_nav_profile"
            android:contentDescription="Profil"
            android:background="@android:color/transparent"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:padding="10dp"
            app:tint="@color/black" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
