<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <!-- AppBar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="0dp"
        android:background="@android:color/white">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/white"
            app:navigationIcon="@drawable/ic_arrow_back_24"
            app:title="Gestion des collectes"
            app:titleTextColor="@color/input_black" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Contenu scrollable sous l'AppBar -->
    <ScrollView
        android:id="@+id/scrollAdmin"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="14dp"
            android:paddingBottom="18dp">

            <!-- Carte calendrier -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCalendar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="6dp"
                app:cardUseCompatPadding="true"
                app:cardBackgroundColor="@color/vert_second">

                <CalendarView
                    android:id="@+id/calendarView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:firstDayOfWeek="2"
                    android:padding="6dp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Date sélectionnée -->
            <TextView
                android:id="@+id/tvSelectedDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Sélectionne un jour dans le calendrier"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/input_black"
                android:gravity="center" />

            <!-- Boutons Ajouter / Supprimer -->
            <LinearLayout
                android:id="@+id/layoutButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddCollecte"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:text="Ajouter collecte"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    app:backgroundTint="@color/vert_principal"
                    app:cornerRadius="16dp"
                    android:layout_marginEnd="8dp"
                    android:elevation="4dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDeleteCollecte"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:text="Supprimer collecte"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    app:backgroundTint="@color/rouge"
                    app:cornerRadius="16dp"
                    android:layout_marginStart="8dp"
                    android:elevation="4dp" />
            </LinearLayout>

            <!-- ===== Formulaire AJOUT (en card) ===== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="6dp"
                app:cardUseCompatPadding="true"
                android:visibility="gone"
                android:id="@+id/layoutAddForm">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/tvAddInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Ajouter une collecte le --/--/----"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/input_black"
                        android:gravity="center"
                        android:layout_marginBottom="10dp" />

                    <Spinner
                        android:id="@+id/spTypeAdd"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:padding="10dp"
                        android:background="@android:color/white" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnConfirmAdd"
                            style="@style/Widget.MaterialComponents.Button"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="Valider"
                            android:textAllCaps="false"
                            android:textColor="@android:color/white"
                            app:backgroundTint="@color/vert_principal"
                            app:cornerRadius="16dp"
                            android:layout_marginEnd="6dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCancelAdd"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="Annuler"
                            android:textAllCaps="false"
                            app:cornerRadius="16dp"
                            android:layout_marginStart="6dp"
                            app:strokeColor="@color/vert_principal"
                            app:strokeWidth="1.5dp"
                            android:textColor="@color/vert_principal" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== Formulaire SUPPRESSION (en card) ===== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/layoutDeleteForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="6dp"
                app:cardUseCompatPadding="true"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/tvDeleteInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Collectes prévues le --/--/----"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/input_black"
                        android:gravity="center"
                        android:layout_marginBottom="10dp" />

                    <CheckBox
                        android:id="@+id/cbVerte"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Poubelle verte (MENAGERES)"
                        android:textColor="@color/input_black"
                        android:paddingVertical="6dp" />

                    <CheckBox
                        android:id="@+id/cbJaune"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Poubelle jaune (RECYCLABLES)"
                        android:textColor="@color/input_black"
                        android:paddingVertical="6dp" />

                    <CheckBox
                        android:id="@+id/cbVerre"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Poubelle verre (VERRE)"
                        android:textColor="@color/input_black"
                        android:paddingVertical="6dp" />

                    <CheckBox
                        android:id="@+id/cbVegetaux"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Déchets verts (VEGETAUX)"
                        android:textColor="@color/input_black"
                        android:paddingVertical="6dp" />

                    <CheckBox
                        android:id="@+id/cbEncombrants"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Encombrants (ENCOMBRANTS)"
                        android:textColor="@color/input_black"
                        android:paddingVertical="6dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnConfirmDelete"
                            style="@style/Widget.MaterialComponents.Button"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="Valider"
                            android:textAllCaps="false"
                            android:textColor="@android:color/white"
                            app:backgroundTint="@color/rouge"
                            app:cornerRadius="16dp"
                            android:layout_marginEnd="6dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCancelDelete"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="Annuler"
                            android:textAllCaps="false"
                            app:cornerRadius="16dp"
                            android:layout_marginStart="6dp"
                            app:strokeColor="@color/vert_principal"
                            app:strokeWidth="1.5dp"
                            android:textColor="@color/vert_principal" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
