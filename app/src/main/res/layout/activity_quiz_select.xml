<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Titre -->
    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Choisir un quiz"
        android:textColor="@android:color/black"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="18dp" />

    <!-- Sélecteur -->
    <Spinner
        android:id="@+id/spinnerQuiz"
        android:layout_width="match_parent"
        android:layout_height="48dp" />

    <!-- Démarrer (primaire) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStart"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="18dp"
        android:text="Démarrer"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        app:backgroundTint="@color/vert_principal"
        app:cornerRadius="28dp" />

    <!-- Voir dernier résultat (secondaire) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLastResult"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:text="Voir dernier résultat"
        android:textAllCaps="false"
        android:textColor="@android:color/black"
        app:backgroundTint="@android:color/transparent"
        app:cornerRadius="28dp"
        app:strokeWidth="2dp"
        app:strokeColor="@color/vert_principal" />

    <!-- Retour (danger/light) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBackHome"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:text="Retour"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        app:backgroundTint="@color/rouge"
        app:cornerRadius="28dp" />

</LinearLayout>
